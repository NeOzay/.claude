# Secrets
.credentials.json

# Fichiers générés / backups
settings.json.bak*
# La sauvegarde du dernier `list-dir reseed` : une marche arrière LOCALE et
# immédiate. L'historique plus ancien est le travail de git, pas le sien.
**/.list/backup/
hooks/rtk-rewrite.sh

# Données d'usage / caches locaux
history.jsonl
stats-cache.json
mcp-needs-auth-cache.json
cache/
backups/
file-history/
paste-cache/
shell-snapshots/

# État runtime du daemon
daemon/
daemon.log
daemon.lock
daemon.status.json

# Sessions / exécution, spécifiques à la machine
sessions/
projects/
# Dumps de discussions (session-dump) : des sessions entières, jamais versionnées
.claude/session-dump/
session-env/
ide/
jobs/
debug/
downloads/

# Télémétrie
telemetry/

# État transitoire
.caveman-active
.last-cleanup
.last-update-result.json
plugins/marketplaces/
plugins/known_marketplaces.json
plugins/store/
plugins/plugin-directory-cache-v2.json
tasks/
state/

__pycache__/
.ruff_cache/
.pytest_cache/
.venv/

# Skills et plugins synchronisés par Claude Code depuis claude.ai : copies gérées hors
# du dépôt, qui ne relèvent pas du garde-fou.
skills/synced/
plugins/synced/

# Mods en cours de développement : le dossier de rechargement à chaud de la session
dev-mods/

# Le tsconfig.json d'un mod étend celui que le moteur pose dans .claude-plugin/types/,
# lui-même ignoré : versionné, il ne vaudrait rien là où le mod ne s'est jamais chargé.
skills/*/tsconfig.json
.claude/skills/*/tsconfig.json

# Brouillons de retours de Claude Code, locaux à la machine.
feedback/

# Prototypes de pipeline-v2 : le tsconfig.json, comme celui d'un mod de skill, et le journal
# qu'une session témoin écrit.
pipeline-v2/*/tsconfig.json
pipeline-v2/*/journal.log

# Desktop en session SSH : sa CLI, ses plugins synchronisés et son état d'exécution.
remote/
