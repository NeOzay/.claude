{
  "typeCheckingMode": "all",
  "pythonVersion": "3.12",
  "include": [
    "skills",
    "scripts"
  ],
  "exclude": [
    "plugins",
    "**/node_modules",
    "**/__pycache__"
  ],
  "extraPaths": [
    "skills/list-dir/scripts",
    "scripts",
    "scripts/tests"
  ],
  "reportImplicitStringConcatenation": false,
  "reportUnusedCallResult": false,
  "reportImportCycles": false
}
